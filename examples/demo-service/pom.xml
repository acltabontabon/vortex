<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acltabontabon</groupId>
    <artifactId>vortex-parent</artifactId>
    <version>0.1.0-alpha.9</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>vortex-demo-service</artifactId>
  <name>Vortex :: Demo Service</name>
  <description>
    checkout-service: an independently runnable sample service with a deliberate, documented
    bounded-concurrency bottleneck. Vortex has no knowledge of its internals and infers
    everything from ordinary telemetry.
  </description>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>vortex-demo-service</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.acltabontabon.vortex.demo.CheckoutServiceApplication</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

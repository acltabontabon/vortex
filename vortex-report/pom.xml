<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>dev.vortex</groupId>
    <artifactId>vortex-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>vortex-report</artifactId>
  <name>Vortex :: Report</name>
  <description>Evidence exporters. Quarantines OpenPDF; com.lowagie types must never escape this module. See docs/adr/adr-029-openpdf-quarantined-in-a-report-module.adoc</description>

  <dependencies>
    <dependency>
      <groupId>dev.vortex</groupId>
      <artifactId>vortex-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
    <dependency>
      <groupId>dev.vortex</groupId>
      <artifactId>vortex-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>report-must-quarantine-its-renderers</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>false</searchTransitive>
                  <excludes>
                    <exclude>dev.vortex:vortex-persistence</exclude>
                    <exclude>dev.vortex:vortex-k6</exclude>
                    <exclude>dev.vortex:vortex-ai</exclude>
                    <exclude>dev.vortex:vortex-openapi</exclude>
                    <exclude>dev.vortex:vortex-app</exclude>
                    <exclude>org.springframework:*</exclude>
                    <exclude>org.springframework.boot:*</exclude>
                  </excludes>
                  <message>vortex-report renders evidence and nothing else. It depends on vortex-core, a PDF library and a JSON library. Reaching for another adapter means the evidence model is missing something, which is a change to vortex-core rather than a dependency here.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

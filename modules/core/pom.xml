<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.acltabontabon</groupId>
    <artifactId>vortex-parent</artifactId>
    <version>0.1.0-alpha.3</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>vortex-core</artifactId>
  <name>Vortex :: Core</name>
  <description>
    Domain model, application services, ports and deterministic calculators.
    ARCHITECTURAL CONSTRAINT: this module has ZERO compile-scope dependencies beyond the JDK.
    Adding one is a deliberate architectural decision requiring an ADR. See docs/adr/adr-013-core-has-no-framework-dependencies.adoc
  </description>

  <dependencies>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals><goal>test-jar</goal></goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>core-must-stay-framework-free</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <searchTransitive>true</searchTransitive>
                  <includes>
                    <include>*:*:*:*:compile</include>
                    <include>*:*:*:*:runtime</include>
                    <include>*:*:*:*:provided</include>
                  </includes>
                  <message>vortex-core must have no compile/runtime/provided dependencies. domain = Java. See docs/adr/adr-013-core-has-no-framework-dependencies.adoc</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

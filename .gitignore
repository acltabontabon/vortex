# Build output
# Anchored to the root and to each module's own top-level target/ directory (fixed depth under
# modules/ and examples/) rather than a bare "target/", which would also match
# com.acltabontabon.vortex.core.target — a source package, not build output.
/target/
modules/*/target/
examples/*/target/
!.mvn/wrapper/maven-wrapper.jar
build/

# web (ADR-035) — built by frontend-maven-plugin into modules/app's static resources
modules/app/src/main/resources/static/app/
web/node_modules/
web/node/
web/dist/

# site (marketing site) — built by Vite for GitHub Pages
site/node_modules/
site/dist/

# Vite's dep-cache — reappears wherever `vite`/`npm run dev` is invoked from, including by
# accident outside web/ (e.g. a stray vortex-web/.vite/ at the repo root).
**/.vite/

# Vortex workspace — local state, never committed.
# The checkout-service example is the exception: a committed .vortex/vortex.yaml is the
# whole point of the portable configuration, and README tells people to run
# `vortex validate examples/checkout-service` against it. examples/demo-service/.vortex/ is
# that service's own local scratch state (like any other module) and stays ignored.
.vortex/
!examples/checkout-service/.vortex/
*.db
*.db-shm
*.db-wal

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.classpath
.project
nbproject/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local secrets — Vortex itself never persists a resolved secret, but keep local credential
# files out of the tree defensively. (modules/app/src/test/resources/discovery-fixtures/ ships
# intentional fake-credential fixtures that are already tracked; this does not affect them.)
.env
.env.*
application-local.*
application-dev.*
*.pem
*.key
*.p12
*.jks
credentials*
secrets*

# Native image build output
modules/app/target/vortex
*.build_artifacts.txt

*.drawio.bkp